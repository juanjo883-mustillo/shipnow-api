# Copiá este archivo a .env y ajustá los valores:  cp .env.example .env
NODE_ENV=development
PORT=3000

# Base de datos
MONGO_URI=mongodb://127.0.0.1:27017/shipnow
# Base INDEPENDIENTE usada por `npm test` (el nombre debe incluir "test")
MONGO_URI_TEST=mongodb://127.0.0.1:27017/shipnow_test

# Logs (Winston): debug | http | info | warn | error
LOG_LEVEL=debug
LOG_DIR=logs

# Archivos (Multer)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Seguridad / producción
CORS_ORIGIN=*
RATE_LIMIT_MAX=100
# Protege /api/mocks/* y /api/logger/*. Obligatoria en producción.
# Si está definida, esos endpoints exigen el header: x-internal-key
INTERNAL_API_KEY=change-me-in-production
